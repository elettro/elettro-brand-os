        "slug": "song-promos",
        "priority": 1,
        "share": 0.75,
        "match": {
          "tagsAny": [
            "song-promo"
          ]
        }
      },
      {
        "slug": "release-posters",
        "priority": 2,
        "share": 0.25,
        "match": {
          "tagsAny": [
            "release-poster"
          ]
        }
      }
    ],
    "minPoolForSector": 1,
