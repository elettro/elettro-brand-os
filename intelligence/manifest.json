{
  "version": 1,
  "sectionHeadingPattern": "^## \\[([a-z0-9-]+)\\] ",
  "precedence": [
    "code-enforced-rules",
    "shared/operating-principles.md#hard-rules",
    "brands/{brand}/brand.md#restrictions",
    "brands/{brand}/platforms.md#{destination}",
    "brands/{brand}/brand.md#{sector}",
    "brands/{brand}/brand.md#core",
    "shared/{task-file}",
    "shared/platforms.md#{destination}"
  ],
  "tasks": {
    "enrich_asset": {
      "consumer": "asset enrichment worker",
      "files": [
        "shared/operating-principles.md",
        "shared/asset-analysis.md",
        "brands/{brand}/brand.md#core"
      ],
      "maxGuidanceTokens": 4000,
      "liveInputs": [
        "asset technical fields",
        "frames",
        "transcript",
        "folder path",
        "brand vocabulary (sectors, content families, tags)",
        "capture metadata (date, GPS, camera)",
        "known subjects (songs, shows, products, locations, people with roles)",
        "candidate sessions with rosters"
      ]
    },
    "select_content": {
      "consumer": "Planner V2 curator (services/dev-api-lambda/curator.mjs), one call per account-week",
      "files": [
        "shared/operating-principles.md",
        "shared/creative-selection.md",
        "shared/platforms.md#{destination}",
        "brands/{brand}/brand.md#core",
        "brands/{brand}/brand.md#{sector}",
        "brands/{brand}/platforms.md#{destination}"
      ],
      "maxGuidanceTokens": 5500,
      "liveInputs": [
        "account and week",
        "slots in order (sector, exploration flag) with top N candidates and score breakdown",
        "recent posts on this account"
      ]
    },
    "write_copy": {
      "consumer": "copy generation for ScheduledPost",
      "files": [
        "shared/operating-principles.md",
        "shared/copywriting.md",
        "shared/platforms.md#{destination}",
        "brands/{brand}/brand.md#core",
        "brands/{brand}/brand.md#{sector}",
        "brands/{brand}/platforms.md#{destination}"
      ],
      "maxGuidanceTokens": 4500,
      "liveInputs": [
        "selected asset",
        "subject facts and links",
        "campaign",
        "last 20 captions on this account",
        "post template copy slots (when templated)"
      ]
    }
  },
  "optionalSections": [
    "brands/{brand}/platforms.md#{destination}",
    "brands/{brand}/brand.md#{sector}"
  ],
  "requiredFiles": [
    "shared/operating-principles.md",
    "brands/{brand}/brand.md"
  ]
}
