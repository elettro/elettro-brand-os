{
  "version": 1,
  "sectionHeadingPattern": "^## \\[([a-z0-9-]+)\\] ",
  "precedence": [
    "code-enforced-rules",
    "shared/operating-principles.md#hard-rules",
    "brands/{brand}/brand.md#restrictions",
    "brands/{brand}/platforms.md#{destination}",
    "brands/{brand}/brand.md#{sector}",
    "brands/{brand}/brand.md#core",
    "shared/{task-file}",
    "shared/platforms.md#{destination}"
  ],
  "tasks": {
    "enrich_asset": {
      "consumer": "asset enrichment worker",
      "files": [
        "shared/operating-principles.md",
        "shared/asset-analysis.md",
        "brands/{brand}/brand.md#core"
      ],
      "maxGuidanceTokens": 3500,
      "liveInputs": ["asset technical fields", "frames", "transcript", "folder path", "brand vocabulary (sectors, content families, tags)", "known subjects (songs, shows, products)"]
    },
    "select_content": {
      "consumer": "Planner V1 step 4",
      "files": [
        "shared/operating-principles.md",
        "shared/creative-selection.md",
        "shared/platforms.md#{destination}",
        "brands/{brand}/brand.md#core",
        "brands/{brand}/brand.md#{sector}",
        "brands/{brand}/platforms.md#{destination}"
      ],
      "maxGuidanceTokens": 4000,
      "liveInputs": ["slot", "top N candidates with score breakdown", "campaign", "recent posts on this account"]
    },
    "write_copy": {
      "consumer": "copy generation for ScheduledPost",
      "files": [
        "shared/operating-principles.md",
        "shared/copywriting.md",
        "shared/platforms.md#{destination}",
        "brands/{brand}/brand.md#core",
        "brands/{brand}/brand.md#{sector}",
        "brands/{brand}/platforms.md#{destination}"
      ],
      "maxGuidanceTokens": 4500,
      "liveInputs": ["selected asset", "subject facts and links", "campaign", "last 20 captions on this account", "post template copy slots (when templated)"]
    }
  },
  "optionalSections": [
    "brands/{brand}/platforms.md#{destination}",
    "brands/{brand}/brand.md#{sector}"
  ],
  "requiredFiles": [
    "shared/operating-principles.md",
    "brands/{brand}/brand.md"
  ]
}
